# Biến môi trường dùng bởi phần AgriLink. Điền giá trị thật vào .env (không commit).

# Cơ sở dữ liệu (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Phân tích câu nhu cầu Bán/Mua: rules (mặc định) | deepseek | gemini
AGRILINK_AI_PROVIDER=rules
AGRILINK_AI_TIMEOUT_MS=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_DAILY_LIMIT=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_DAILY_LIMIT=

# Chỉ dùng cho script demo / smoke test ở máy local
APP_PORT=3000
SEED_FARMER_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_PASSWORD=
